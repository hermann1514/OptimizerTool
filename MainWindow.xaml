            <RadioButton x:Name="SwFltUpdates"   GroupName="SwFlt" Style="{StaticResource Seg}" Content="Update verfügbar"/>
            <RadioButton x:Name="SwFltUnmanaged" GroupName="SwFlt" Style="{StaticResource Seg}" Content="Nicht über winget"/>
