              <Button x:Name="BtnWuRestart" DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}" Content="Jetzt neu starten …" Margin="12,0,0,0"/>
              <TextBlock TextWrapping="Wrap" Foreground="#5E4B1F" VerticalAlignment="Center"
