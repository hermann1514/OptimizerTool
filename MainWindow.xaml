          <Button x:Name="BtnSwSelectNone" DockPanel.Dock="Left" Style="{StaticResource BtnLink}" Content="Auswahl aufheben" Margin="12,0,0,0" VerticalAlignment="Center"/>
          <StackPanel x:Name="SwProgress" DockPanel.Dock="Left" Margin="24,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
