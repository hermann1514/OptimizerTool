        <StackPanel>
          <TextBlock Style="{StaticResource PageTitle}" Text="Windows Update"/>
          <TextBlock Style="{StaticResource PageSub}"
                     Text="Verfügbare und installierte Updates der eingestellten Update-Quelle (Windows Update, Microsoft Update oder WSUS). Installiert wird im Hintergrund, nur mit Administratorrechten. „Sicherheitslücken“ gleicht den installierten Build mit dem Microsoft Security Update Guide ab und zeigt offene CVEs mit dem Update, das sie behebt."/>
        </StackPanel>

