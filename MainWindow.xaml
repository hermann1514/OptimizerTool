            <TextBlock x:Name="TxtSwLoading" Text="Installierte Software und Updates werden über winget geprüft …" Foreground="#8A8E91"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
          </Grid>
        </Border>
      </Grid>

