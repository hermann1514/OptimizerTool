                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock x:Name="TxtWuAvailEmpty" Text="Keine Updates verfügbar." Foreground="#9A9EA1" TextWrapping="Wrap" TextAlignment="Center" Margin="40,0"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
              <TextBlock x:Name="TxtWuLoading" Text="Windows Update sucht nach Updates … (kann einige Minuten dauern)" Foreground="#8A8E91"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
          </Border>

          <!-- Installiert (Verlauf und Hotfixes) -->
          <Border x:Name="WuPanelHist" Grid.Row="1" Background="White" BorderBrush="#E3E3DF" BorderThickness="1" CornerRadius="4" Padding="1" Visibility="Collapsed">
            <Grid>
              <DataGrid x:Name="GridWuHist">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Datum" Width="125" Binding="{Binding DateText}" SortMemberPath="Date" ElementStyle="{StaticResource CellText}"/>
                  <DataGridTextColumn Header="Update" Width="3*" Binding="{Binding Title}" ElementStyle="{StaticResource CellText}"/>
                  <DataGridTextColumn Header="KB" Width="90" Binding="{Binding Kb}" ElementStyle="{StaticResource CellText}"/>
                  <DataGridTextColumn Header="Vorgang" Width="105" Binding="{Binding OpText}" ElementStyle="{StaticResource CellText}"/>
                  <DataGridTemplateColumn Header="Ergebnis" Width="125" SortMemberPath="ResultText">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding ResultText}" ToolTip="{Binding Tip}" VerticalAlignment="Center">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Foreground" Value="#1F6F78"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Failed}" Value="True">
                                  <Setter Property="Foreground" Value="#A02A22"/>
                                  <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock x:Name="TxtWuHistEmpty" Text="Keine passenden Einträge." Foreground="#9A9EA1"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
          </Border>

          <!-- Sicherheitslücken -->
          <Border x:Name="WuPanelCve" Grid.Row="1" Background="White" BorderBrush="#E3E3DF" BorderThickness="1" CornerRadius="4" Padding="1" Visibility="Collapsed">
            <Grid>
              <DataGrid x:Name="GridWuCve" SelectionMode="Single">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="CVE" Width="125" Binding="{Binding Cve}" ElementStyle="{StaticResource CellText}"/>
                  <DataGridTemplateColumn Header="Sicherheitslücke" Width="3*" SortMemberPath="Title">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <StackPanel ToolTip="{Binding Tip}">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding Impact}" Foreground="#80858A" FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Schweregrad" Width="100" SortMemberPath="Severity">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Border Style="{StaticResource SevBadge}">
                          <TextBlock Text="{Binding Severity}" FontSize="11.5"/>
                        </Border>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="CVSS" Width="60" Binding="{Binding ScoreText}" SortMemberPath="Score" ElementStyle="{StaticResource CellText}"/>
                  <DataGridTemplateColumn Header="Ausgenutzt" Width="90" SortMemberPath="Exploited">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding ExploitedText}" VerticalAlignment="Center">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Foreground" Value="#5F6468"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Exploited}" Value="True">
                                  <Setter Property="Foreground" Value="#A02A22"/>
                                  <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Behoben durch" Width="150" Binding="{Binding FixText}" ElementStyle="{StaticResource CellText}"/>
                  <DataGridTextColumn Header="Behebung" Width="1.4*" Binding="{Binding StatusText}" ElementStyle="{StaticResource CellText}"/>
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock x:Name="TxtWuCveEmpty" Foreground="#9A9EA1" TextWrapping="Wrap" TextAlignment="Center" Margin="40,0"
                         Text="Noch nicht geprüft – „Sicherheitslücken prüfen (online)“ fragt die Microsoft-Datenbank für dieses System ab."
                         HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
          </Border>
        </Grid>
      </Grid>

      <!-- Seite: System -->
      <Grid x:Name="PageSystem" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
            <Button x:Name="BtnSysCopy" Style="{StaticResource BtnSecondary}" Content="Als Text kopieren"/>
            <Button x:Name="BtnSysReload" Style="{StaticResource BtnSecondary}" Content="Aktualisieren" Margin="8,0,0,0"/>
          </StackPanel>
          <StackPanel>
            <TextBlock Style="{StaticResource PageTitle}" Text="System"/>
            <TextBlock Style="{StaticResource PageSub}" Text="Überblick über Betriebssystem und Hardware dieses Rechners."/>
          </StackPanel>
        </DockPanel>
        <ScrollViewer Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="14"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="SysColLeft"/>
            <StackPanel x:Name="SysColRight" Grid.Column="2"/>
          </Grid>
        </ScrollViewer>
        <TextBlock x:Name="TxtSysLoading" Grid.Row="1" Margin="0,24,0,0" Foreground="#8A8E91"
                   Text="Systeminformationen werden gelesen …" Visibility="Collapsed"/>
      </Grid>

      <!-- Seite: Sicherung -->
      <Grid x:Name="PageBackup" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Style="{StaticResource PageTitle}" Text="Sicherung"/>
          <TextBlock Style="{StaticResource PageSub}"
                     Text="Speichert, welche Autostart-Einträge aktiv oder deaktiviert sind und welchen Starttyp die Dienste haben. Vor der ersten Änderung pro Sitzung und vor jeder Wiederherstellung wird automatisch gesichert. Zusätzlich entsteht jeweils ein .reg-Export der betroffenen Registry-Schlüssel."/>
        </StackPanel>
        <DockPanel Grid.Row="1" Margin="0,18,0,0" LastChildFill="False">
          <Button x:Name="BtnBackupCreate"  DockPanel.Dock="Left" Style="{StaticResource BtnPrimary}"   Content="Sicherung erstellen"/>
          <Button x:Name="BtnBackupRestore" DockPanel.Dock="Left" Style="{StaticResource BtnSecondary}" Content="Wiederherstellen" Margin="8,0,0,0"/>
          <Button x:Name="BtnBackupDelete"  DockPanel.Dock="Left" Style="{StaticResource BtnSecondary}" Content="Löschen" Margin="8,0,0,0"/>
          <Button x:Name="BtnBackupFolder"  DockPanel.Dock="Right" Style="{StaticResource BtnLink}"     Content="Ordner öffnen" VerticalAlignment="Center"/>
        </DockPanel>
        <Border Grid.Row="2" Margin="0,14,0,0" Background="White" BorderBrush="#E3E3DF" BorderThickness="1" CornerRadius="4" Padding="1">
          <Grid>
            <DataGrid x:Name="GridBackups">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Erstellt"    Width="165" Binding="{Binding Created}"  ElementStyle="{StaticResource CellText}" SortMemberPath="SortKey"/>
                <DataGridTextColumn Header="Anlass"      Width="1.2*" Binding="{Binding Reason}"  ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="Einträge"    Width="80"  Binding="{Binding Count}"    ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="Aktiv"       Width="70"  Binding="{Binding Active}"   ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="Deaktiviert" Width="95"  Binding="{Binding Disabled}" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="Datei"       Width="1.5*" Binding="{Binding File}"    ElementStyle="{StaticResource CellMono}"/>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="TxtBackupEmpty" Text="Noch keine Sicherungen vorhanden." Foreground="#9A9EA1"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
          </Grid>
        </Border>
        <TextBlock x:Name="TxtBackupPath" Grid.Row="3" Margin="0,10,0,0" FontFamily="Consolas" FontSize="11.5" Foreground="#80858A"/>
      </Grid>

      <!-- Seite: Protokoll -->
      <Grid x:Name="PageLog" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Style="{StaticResource PageTitle}" Text="Protokoll"/>
          <TextBlock Style="{StaticResource PageSub}" Text="Jede Änderung mit Zeitpunkt, neueste oben. Pro Tag entsteht eine Datei."/>
        </StackPanel>
        <DockPanel Grid.Row="1" Margin="0,18,0,0" LastChildFill="False">
          <ComboBox x:Name="CmbLogFiles" DockPanel.Dock="Left" Width="240" Padding="8,5" VerticalContentAlignment="Center"/>
          <Button x:Name="BtnLogReload" DockPanel.Dock="Left" Style="{StaticResource BtnSecondary}" Content="Aktualisieren" Margin="8,0,0,0"/>
          <Button x:Name="BtnLogFolder" DockPanel.Dock="Right" Style="{StaticResource BtnLink}" Content="Ordner öffnen" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBox x:Name="TxtLog" Grid.Row="2" Margin="0,14,0,0" Style="{StaticResource Input}" Padding="12,10"
                 IsReadOnly="True" FontFamily="Consolas" FontSize="12" Foreground="#2E3236"
                 TextWrapping="NoWrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
      </Grid>
    </Grid>

    <!-- Statusleiste -->
    <Border Grid.Row="1" Grid.Column="1" Background="#ECECE9" BorderBrush="#DEDED9" BorderThickness="0,1,0,0">
      <DockPanel Margin="30,0">
        <TextBlock x:Name="TxtCounts" DockPanel.Dock="Right" Foreground="#5F6468" FontSize="12" VerticalAlignment="Center"/>
        <TextBlock x:Name="TxtStatus" Foreground="#5F6468" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
