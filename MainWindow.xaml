<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Windows-Optimizer" Width="1180" Height="740" MinWidth="960" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="#F4F4F2"
        FontFamily="Segoe UI" FontSize="13" Foreground="#1D2023"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

  <Window.Resources>

    <!-- Navigation links -->
    <Style x:Key="Nav" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#AEB4B9"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid x:Name="bg" Background="Transparent" Height="38">
              <Border x:Name="bar" Width="3" HorizontalAlignment="Left" Background="Transparent"/>
              <ContentPresenter Margin="22,0,0,0" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bg" Property="Background" Value="#2B3135"/>
                <Setter Property="Foreground" Value="#E6E8EA"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bg" Property="Background" Value="#30373C"/>
                <Setter TargetName="bar" Property="Background" Value="#5DB4BE"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Buttons -->
    <Style x:Key="BtnBase" TargetType="Button">
      <Setter Property="Padding" Value="14,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
      <Setter Property="Background" Value="#1F6F78"/>
      <Setter Property="BorderBrush" Value="#1F6F78"/>
      <Setter Property="Foreground" Value="White"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#195C64"/>
          <Setter Property="BorderBrush" Value="#195C64"/>
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="#134A51"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="BtnSecondary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#CBCBC5"/>
      <Setter Property="Foreground" Value="#1D2023"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#F0F0EC"/>
          <Setter Property="BorderBrush" Value="#B9B9B2"/>
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="#E6E6E1"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="BtnLink" TargetType="Button" BasedOn="{StaticResource BtnBase}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="#1F6F78"/>
      <Setter Property="Padding" Value="4,2"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Foreground" Value="#134A51"/>
          <Setter Property="Background" Value="#E9F2F3"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="BtnSide" TargetType="Button" BasedOn="{StaticResource BtnBase}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="#4A5157"/>
      <Setter Property="Foreground" Value="#DADDE0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="10,5"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#30373C"/>
          <Setter Property="BorderBrush" Value="#5D656B"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Segment-Filter -->
    <Style x:Key="Seg" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#3F4447"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" Background="White" BorderBrush="#CBCBC5" BorderThickness="1" CornerRadius="3" Padding="12,5" Margin="0,0,4,0">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#F0F0EC"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="#23282C"/>
                <Setter TargetName="b" Property="BorderBrush" Value="#23282C"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Eingabefeld -->
    <Style x:Key="Input" TargetType="TextBox">
      <Setter Property="Padding" Value="7,5"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#CBCBC5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="#1F6F78"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Schalter -->
    <Style x:Key="Switch" TargetType="ToggleButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Grid Width="36" Height="20" Background="Transparent">
              <Border x:Name="track" CornerRadius="10" Background="#C6C8C5"/>
              <Ellipse x:Name="knob" Width="14" Height="14" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="#1F6F78"/>
                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="knob" Property="Margin" Value="0,0,3,0"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="track" Property="Opacity" Value="0.85"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="track" Property="Opacity" Value="0.35"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Tabellen -->
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="RowHeaderWidth" Value="0"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/>
      <Setter Property="HorizontalGridLinesBrush" Value="#EEEEEA"/>
      <Setter Property="AutoGenerateColumns" Value="False"/>
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="CanUserAddRows" Value="False"/>
      <Setter Property="CanUserDeleteRows" Value="False"/>
      <Setter Property="CanUserResizeRows" Value="False"/>
      <Setter Property="CanUserReorderColumns" Value="False"/>
      <Setter Property="SelectionMode" Value="Single"/>
      <Setter Property="SelectionUnit" Value="FullRow"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#6B7075"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="10,9"/>
      <Setter Property="BorderBrush" Value="#E3E3DF"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridColumnHeader">
            <Grid>
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                <StackPanel Orientation="Horizontal">
                  <ContentPresenter VerticalAlignment="Center"/>
                  <Path x:Name="arrow" Visibility="Collapsed" Margin="6,1,0,0" VerticalAlignment="Center" Fill="#6B7075" Data="M0,0 L7,0 L3.5,4 Z"/>
                </StackPanel>
              </Border>
              <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="6" Cursor="SizeWE" Opacity="0"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="SortDirection" Value="Ascending">
                <Setter TargetName="arrow" Property="Visibility" Value="Visible"/>
                <Setter TargetName="arrow" Property="Data" Value="M0,4 L7,4 L3.5,0 Z"/>
              </Trigger>
              <Trigger Property="SortDirection" Value="Descending">
                <Setter TargetName="arrow" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="DataGridRow">
      <Setter Property="Background" Value="White"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#F7F7F5"/>
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#E9F2F3"/>
        </Trigger>
        <DataTrigger Binding="{Binding StatusText}" Value="Deaktiviert">
          <Setter Property="Foreground" Value="#878B8E"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusText}" Value="Nicht zutreffend">
          <Setter Property="Foreground" Value="#878B8E"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusText}" Value="Nicht vorhanden">
          <Setter Property="Foreground" Value="#878B8E"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridCell">
            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="CellText" TargetType="TextBlock">
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="CellMono" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="#5F6468"/>
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="21"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="PageSub" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#6B7075"/>
      <Setter Property="Margin" Value="0,4,0,0"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="MaxWidth" Value="760"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- Dienste: Starttypen und RDS-Badge -->
    <x:Array x:Key="StartTypes" Type="sys:String">
      <sys:String>Automatisch</sys:String>
      <sys:String>Automatisch (verzögert)</sys:String>
      <sys:String>Manuell</sys:String>
      <sys:String>Deaktiviert</sys:String>
    </x:Array>

    <Style x:Key="RdsBadge" TargetType="Border">
      <Setter Property="Background" Value="#EEF0EF"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="Padding" Value="6,2"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="TextElement.Foreground" Value="#6B7075"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding RdsRating}" Value="Benötigt">
          <Setter Property="Background" Value="#E3F0F1"/>
          <Setter Property="TextElement.Foreground" Value="#1F6F78"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding RdsRating}" Value="Deaktivierbar">
          <Setter Property="Background" Value="#FBEAEA"/>
          <Setter Property="TextElement.Foreground" Value="#A02A22"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding RdsRating}" Value="Prüfen">
          <Setter Property="Background" Value="#FBF5E8"/>
          <Setter Property="TextElement.Foreground" Value="#7A5B12"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding RdsRating}" Value="Drittanbieter">
          <Setter Property="Background" Value="#E8EEF6"/>
          <Setter Property="TextElement.Foreground" Value="#3A5A80"/>
        </DataTrigger>
        <!-- RDS-Optimierung: Empfehlungsstufe -->
        <DataTrigger Binding="{Binding RdsRating}" Value="Empfohlen">
          <Setter Property="Background" Value="#E3F0F1"/>
          <Setter Property="TextElement.Foreground" Value="#1F6F78"/>
        </DataTrigger>
        <!-- Software: Update-Status -->
        <DataTrigger Binding="{Binding RdsRating}" Value="Update verfügbar">
          <Setter Property="Background" Value="#FBF5E8"/>
          <Setter Property="TextElement.Foreground" Value="#7A5B12"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding RdsRating}" Value="Aktuell">
          <Setter Property="Background" Value="#E3F0F1"/>
          <Setter Property="TextElement.Foreground" Value="#1F6F78"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding RdsRating}" Value="Aktualisiert">
          <Setter Property="Background" Value="#E3F0F1"/>
          <Setter Property="TextElement.Foreground" Value="#1F6F78"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding RdsRating}" Value="Fehler">
          <Setter Property="Background" Value="#FBEAEA"/>
          <Setter Property="TextElement.Foreground" Value="#A02A22"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding RdsRating}" Value="Läuft …">
          <Setter Property="Background" Value="#E8EEF6"/>
          <Setter Property="TextElement.Foreground" Value="#3A5A80"/>
        </DataTrigger>
        <!-- Startmenü: Sichtbarkeit -->
        <DataTrigger Binding="{Binding RdsRating}" Value="Alle">
          <Setter Property="Background" Value="#E3F0F1"/>
          <Setter Property="TextElement.Foreground" Value="#1F6F78"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding RdsRating}" Value="Ausgeblendet">
          <Setter Property="Background" Value="#FBEAEA"/>
          <Setter Property="TextElement.Foreground" Value="#A02A22"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding RdsRating}" Value="Eingeschränkt">
          <Setter Property="Background" Value="#FBF5E8"/>
          <Setter Property="TextElement.Foreground" Value="#7A5B12"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding RdsRating}" Value="Hinweis">
          <Setter Property="Background" Value="#E8EEF6"/>
          <Setter Property="TextElement.Foreground" Value="#3A5A80"/>
        </DataTrigger>
        <!-- Windows Update: Status je Update -->
        <DataTrigger Binding="{Binding RdsRating}" Value="Installiert">
          <Setter Property="Background" Value="#E3F0F1"/>
          <Setter Property="TextElement.Foreground" Value="#1F6F78"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding RdsRating}" Value="Neustart nötig">
          <Setter Property="Background" Value="#FBF5E8"/>
          <Setter Property="TextElement.Foreground" Value="#7A5B12"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding RdsRating}" Value="Lädt …">
          <Setter Property="Background" Value="#E8EEF6"/>
          <Setter Property="TextElement.Foreground" Value="#3A5A80"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding RdsRating}" Value="Installiert …">
          <Setter Property="Background" Value="#E8EEF6"/>
          <Setter Property="TextElement.Foreground" Value="#3A5A80"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding RdsRating}" Value="Wartet …">
          <Setter Property="Background" Value="#E8EEF6"/>
          <Setter Property="TextElement.Foreground" Value="#3A5A80"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Schweregrad (Windows Update / CVE) -->
    <Style x:Key="SevBadge" TargetType="Border">
      <Setter Property="Background" Value="#EEF0EF"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="Padding" Value="6,2"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="TextElement.Foreground" Value="#6B7075"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Severity}" Value="Kritisch">
          <Setter Property="Background" Value="#FBEAEA"/>
          <Setter Property="TextElement.Foreground" Value="#A02A22"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Severity}" Value="Wichtig">
          <Setter Property="Background" Value="#FBF5E8"/>
          <Setter Property="TextElement.Foreground" Value="#7A5B12"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Severity}" Value="Mittel">
          <Setter Property="Background" Value="#E8EEF6"/>
          <Setter Property="TextElement.Foreground" Value="#3A5A80"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Severity}" Value="">
          <Setter Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid Background="#F4F4F2">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="210"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="28"/>
    </Grid.RowDefinitions>

    <!-- Seitenleiste -->
    <DockPanel Grid.RowSpan="2" Background="#23282C">
      <StackPanel DockPanel.Dock="Top" Margin="22,24,16,18">
        <StackPanel Orientation="Horizontal">
          <Image x:Name="ImgLogo" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"
                 RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock Text="Windows-Optimizer" Foreground="White" FontSize="14.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock x:Name="TxtMachine" Foreground="#8B9196" FontSize="12" Margin="0,3,0,0"/>
      </StackPanel>
      <Border DockPanel.Dock="Top" Height="1" Background="#343A3F" Margin="0,0,0,10"/>

      <StackPanel DockPanel.Dock="Bottom" Margin="22,0,16,18">
        <TextBlock Text="Rechte" Foreground="#7D848A" FontSize="11.5"/>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
          <Ellipse x:Name="DotRights" Width="7" Height="7" Fill="#C9A227" VerticalAlignment="Center"/>
          <TextBlock x:Name="TxtRights" Foreground="#DADDE0" FontSize="12.5" Margin="7,0,0,0"/>
        </StackPanel>
        <Button x:Name="BtnElevate" Style="{StaticResource BtnSide}" Content="Als Administrator starten"
                ToolTip="Startet das Tool neu mit Administratorrechten, um auch Einträge für alle Benutzer zu ändern."
                Margin="0,10,0,0" HorizontalAlignment="Stretch"/>
        <TextBlock x:Name="TxtVersion" Foreground="#6B7177" FontSize="11.5" Margin="0,18,0,0"/>
      </StackPanel>

      <StackPanel DockPanel.Dock="Top">
        <RadioButton x:Name="NavAutostart" GroupName="Nav" Style="{StaticResource Nav}" Content="Autostart" IsChecked="True"/>
        <RadioButton x:Name="NavServices"  GroupName="Nav" Style="{StaticResource Nav}" Content="Dienste"/>
        <RadioButton x:Name="NavTweaks"    GroupName="Nav" Style="{StaticResource Nav}" Content="Windows-Tweaks"/>
        <RadioButton x:Name="NavOptimize"  GroupName="Nav" Style="{StaticResource Nav}" Content="RDS-Optimierung"/>
        <RadioButton x:Name="NavStartMenu" GroupName="Nav" Style="{StaticResource Nav}" Content="Startmenü"/>
        <RadioButton x:Name="NavSoftware"  GroupName="Nav" Style="{StaticResource Nav}" Content="Software"/>
        <RadioButton x:Name="NavUpdates"   GroupName="Nav" Style="{StaticResource Nav}" Content="Windows Update"/>
        <RadioButton x:Name="NavSystem"    GroupName="Nav" Style="{StaticResource Nav}" Content="System"/>
        <RadioButton x:Name="NavBackup"    GroupName="Nav" Style="{StaticResource Nav}" Content="Sicherung"/>
        <RadioButton x:Name="NavLog"       GroupName="Nav" Style="{StaticResource Nav}" Content="Protokoll"/>
      </StackPanel>
    </DockPanel>

    <!-- Inhalt -->
    <Grid Grid.Column="1" Margin="30,26,30,18">

      <!-- Seite: Autostart -->
      <Grid x:Name="PageAutostart">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
          <TextBlock Style="{StaticResource PageTitle}" Text="Autostart-Programme"/>
          <TextBlock Style="{StaticResource PageSub}"
                     Text="Programme, die bei der Anmeldung automatisch starten. Ausschalten verschiebt den Eintrag in einen Ablagebereich („WindowsOptimizerDisabled“), den Windows nicht ausführt – nichts wird gelöscht, Einschalten stellt ihn unverändert wieder her."/>
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,18,0,0" LastChildFill="False">
          <Grid DockPanel.Dock="Left" Width="300">
            <TextBox x:Name="TxtSearch" Style="{StaticResource Input}"/>
            <TextBlock x:Name="TxtSearchHint" Text="Suchen: Name, Herausgeber, Pfad" Foreground="#9A9EA1"
                       Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
          </Grid>
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="12,0,0,0">
            <RadioButton x:Name="FltAll" GroupName="Flt" Style="{StaticResource Seg}" Content="Alle" IsChecked="True"/>
            <RadioButton x:Name="FltOn"  GroupName="Flt" Style="{StaticResource Seg}" Content="Aktiv"/>
            <RadioButton x:Name="FltOff" GroupName="Flt" Style="{StaticResource Seg}" Content="Deaktiviert"/>
          </StackPanel>
          <Button x:Name="BtnRefresh" DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}" Content="Neu einlesen"/>
        </DockPanel>

        <StackPanel Grid.Row="2">
          <Border x:Name="ApprovedHint" Margin="0,14,0,0" Background="#FBF5E8" BorderBrush="#EADBB8"
                  BorderThickness="1" CornerRadius="3" Padding="12,6" Visibility="Collapsed">
            <DockPanel>
              <Button x:Name="BtnFixApproved" DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Content="Endgültig deaktivieren"
                      Margin="12,0,0,0" VerticalAlignment="Center"
                      ToolTip="Verschiebt diese Einträge in die Ablage – Windows startet sie dann sicher nicht mehr. Vorher wird automatisch gesichert."/>
              <TextBlock x:Name="TxtApprovedHint" TextWrapping="Wrap" Foreground="#5E4B1F" VerticalAlignment="Center"/>
            </DockPanel>
          </Border>
          <Border x:Name="AdminHint" Margin="0,14,0,0" Background="#FBF5E8" BorderBrush="#EADBB8"
                  BorderThickness="1" CornerRadius="3" Padding="12,8" Visibility="Collapsed">
            <TextBlock TextWrapping="Wrap" Foreground="#5E4B1F"
                       Text="Einträge für alle Benutzer (HKLM und Startordner für alle) lassen sich nur mit Administratorrechten ändern. Sie werden angezeigt, die Schalter sind gesperrt."/>
          </Border>
        </StackPanel>

        <Border Grid.Row="3" Margin="0,14,0,0" Background="White" BorderBrush="#E3E3DF" BorderThickness="1" CornerRadius="4" Padding="1">
          <Grid>
            <DataGrid x:Name="GridEntries">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="62" SortMemberPath="StatusText" CanUserResize="False">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <ToggleButton Tag="toggle" Style="{StaticResource Switch}" HorizontalAlignment="Center"
                                    IsChecked="{Binding Enabled, Mode=OneWay}" IsEnabled="{Binding CanModify}"
                                    ToolTip="{Binding SwitchTip}" ToolTipService.ShowOnDisabled="True"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Programm" Width="2.3*" SortMemberPath="Name">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel>
                        <DockPanel>
                          <Border DockPanel.Dock="Right" Background="#FBEAEA" CornerRadius="3" Padding="5,0" Margin="8,0,0,0" VerticalAlignment="Center">
                            <Border.Style>
                              <Style TargetType="Border">
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding MissingText}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding MissingText}" Foreground="#A02A22" FontSize="11"/>
                          </Border>
                          <Border DockPanel.Dock="Right" Background="#FBF5E8" CornerRadius="3" Padding="5,0" Margin="8,0,0,0" VerticalAlignment="Center"
                                  ToolTip="Nur per Task-Manager (StartupApproved) gesperrt – manche Programme starten trotzdem. Über „Endgültig deaktivieren“ oben in die Ablage verschieben.">
                            <Border.Style>
                              <Style TargetType="Border">
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding ApprovedText}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding ApprovedText}" Foreground="#7A5B12" FontSize="11"/>
                          </Border>
                          <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Command}" ToolTip="{Binding Command}" FontFamily="Consolas" FontSize="11.5"
                                   Foreground="#80858A" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Herausgeber" Width="1.3*" SortMemberPath="PublisherText">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel>
                        <TextBlock Text="{Binding PublisherText}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Description}" Foreground="#80858A" FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Quelle" Width="150" SortMemberPath="SourceLabel">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Border Background="#EEF0EF" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left" ToolTip="{Binding LocationTip}">
                        <TextBlock Text="{Binding SourceLabel}" FontSize="11.5" Foreground="#3F4447"/>
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Bereich" Width="105" Binding="{Binding Scope}" ElementStyle="{StaticResource CellText}"/>

                <DataGridTemplateColumn Header="Status" Width="95" SortMemberPath="StatusText">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding StatusText}">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#878B8E"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding StatusText}" Value="Aktiv">
                                <Setter Property="Foreground" Value="#1F6F78"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="" Width="88" CanUserResize="False">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Button Tag="open" Style="{StaticResource BtnLink}" Content="Anzeigen" ToolTip="Im Explorer anzeigen" HorizontalAlignment="Left"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="TxtEmpty" Text="Keine passenden Einträge." Foreground="#9A9EA1"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
          </Grid>
        </Border>
      </Grid>

      <!-- Seite: Dienste -->
      <Grid x:Name="PageServices" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
          <TextBlock Style="{StaticResource PageTitle}" Text="Dienste"/>
          <TextBlock Style="{StaticResource PageSub}"
                     Text="Windows-Dienste mit Starttyp. Die Spalte „Citrix RDS“ ist eine allgemeine Einschätzung für Citrix-Server-VDA/RDS-Hosts (angelehnt an Citrix Optimizer, Microsoft WDOT und den Microsoft-Dienstempfehlungen): Benötigt · Belassen · Prüfen · Deaktivierbar · Drittanbieter. Begründung im Tooltip – vor dem Deaktivieren immer im eigenen Umfeld testen."/>
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,18,0,0" LastChildFill="False">
          <Grid DockPanel.Dock="Left" Width="300">
            <TextBox x:Name="TxtSvcSearch" Style="{StaticResource Input}"/>
            <TextBlock x:Name="TxtSvcSearchHint" Text="Suchen: Name, Beschreibung, Einstufung" Foreground="#9A9EA1"
                       Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
          </Grid>
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="12,0,0,0">
            <RadioButton x:Name="SvcFltAll"    GroupName="SvcFlt" Style="{StaticResource Seg}" Content="Alle" IsChecked="True"/>
            <RadioButton x:Name="SvcFltAuto"   GroupName="SvcFlt" Style="{StaticResource Seg}" Content="Automatisch"/>
            <RadioButton x:Name="SvcFltManual" GroupName="SvcFlt" Style="{StaticResource Seg}" Content="Manuell"/>
            <RadioButton x:Name="SvcFltOff"    GroupName="SvcFlt" Style="{StaticResource Seg}" Content="Deaktiviert"/>
          </StackPanel>
          <Button x:Name="BtnSvcRefresh" DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}" Content="Neu einlesen"/>
        </DockPanel>

        <Border x:Name="SvcAdminHint" Grid.Row="2" Margin="0,14,0,0" Background="#FBF5E8" BorderBrush="#EADBB8"
                BorderThickness="1" CornerRadius="3" Padding="12,8" Visibility="Collapsed">
          <TextBlock TextWrapping="Wrap" Foreground="#5E4B1F"
                     Text="Der Starttyp von Diensten lässt sich nur mit Administratorrechten ändern. Die Dienste werden angezeigt, die Auswahl ist gesperrt."/>
        </Border>

        <Border Grid.Row="3" Margin="0,14,0,0" Background="White" BorderBrush="#E3E3DF" BorderThickness="1" CornerRadius="4" Padding="1">
          <Grid>
            <DataGrid x:Name="GridServices">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="Dienst" Width="2.3*" SortMemberPath="DisplayName">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel ToolTip="{Binding Description}">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Name}" FontFamily="Consolas" FontSize="11.5"
                                   Foreground="#80858A" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Starttyp" Width="190" SortMemberPath="StartTypeText">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <ComboBox Tag="starttype" ItemsSource="{StaticResource StartTypes}"
                                SelectedItem="{Binding StartTypeText, Mode=OneWay}" IsEnabled="{Binding CanModify}"
                                ToolTip="{Binding SwitchTip}" ToolTipService.ShowOnDisabled="True"
                                Background="White" BorderBrush="#CBCBC5" Padding="8,3" VerticalContentAlignment="Center"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Status" Width="90" SortMemberPath="StateText">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding StateText}">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#878B8E"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding StateText}" Value="Läuft">
                                <Setter Property="Foreground" Value="#1F6F78"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Citrix RDS" Width="125" SortMemberPath="RdsRating">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource RdsBadge}" ToolTip="{Binding RdsText}">
                        <TextBlock Text="{Binding RdsRating}" FontSize="11.5"/>
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Konto" Width="1*" Binding="{Binding StartName}" ElementStyle="{StaticResource CellText}"/>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="TxtSvcEmpty" Text="Keine passenden Dienste." Foreground="#9A9EA1"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            <TextBlock x:Name="TxtSvcLoading" Text="Dienste werden gelesen …" Foreground="#8A8E91"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
          </Grid>
        </Border>
      </Grid>

      <!-- Seite: Windows-Tweaks -->
      <Grid x:Name="PageTweaks" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
          <TextBlock Style="{StaticResource PageTitle}" Text="Windows-Tweaks"/>
          <TextBlock Style="{StaticResource PageSub}"
                     Text="Bewährte Einstellungen für das laufende Windows: Datenschutz, Leistung, Bedienung und System. Jeder Punkt ist einzeln auswählbar und mit Erklärung (Tooltip); vor der ersten Änderung wird der ursprüngliche Zustand gesichert, „Rückgängig“ stellt ihn wieder her. Einmalige Aktionen lassen sich nicht rückgängig machen."/>
        </StackPanel>

        <WrapPanel x:Name="TwDetect" Grid.Row="1" Margin="0,16,0,0"/>

        <StackPanel Grid.Row="2">
          <DockPanel Margin="0,4,0,0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="Benutzer-Tweaks gelten für:" VerticalAlignment="Center" Foreground="#5F6468"/>
            <ComboBox x:Name="CmbTwScope" DockPanel.Dock="Left" Width="330" Margin="10,0,0,0" Padding="8,4" VerticalContentAlignment="Center"
                      ToolTip="Geltungsbereich der Einstellungen, die pro Benutzer gespeichert werden (HKCU)"/>
          </DockPanel>
          <Border x:Name="TwAdminHint" Margin="0,8,0,0" Background="#FBF5E8" BorderBrush="#EADBB8"
                  BorderThickness="1" CornerRadius="3" Padding="12,8" Visibility="Collapsed">
            <TextBlock TextWrapping="Wrap" Foreground="#5E4B1F"
                       Text="Ohne Administratorrechte lassen sich nur Benutzer-Tweaks (Art „Benutzer“) für das eigene Konto ändern. Rechnerweite Tweaks und einmalige Aktionen sind gesperrt."/>
          </Border>
        </StackPanel>

        <DockPanel Grid.Row="3" Margin="0,10,0,0" LastChildFill="False">
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
            <RadioButton x:Name="TwFltApplicable" GroupName="TwFlt" Style="{StaticResource Seg}" Content="Zutreffend" IsChecked="True"/>
            <RadioButton x:Name="TwFltOpen"       GroupName="TwFlt" Style="{StaticResource Seg}" Content="Offen"/>
            <RadioButton x:Name="TwFltDone"       GroupName="TwFlt" Style="{StaticResource Seg}" Content="Umgesetzt"/>
            <RadioButton x:Name="TwFltAll"        GroupName="TwFlt" Style="{StaticResource Seg}" Content="Alle"/>
          </StackPanel>
          <ComboBox x:Name="CmbTwGroup" DockPanel.Dock="Left" Width="175" Margin="10,0,0,0" Padding="8,4" VerticalContentAlignment="Center" ToolTip="Bereich"/>
          <Button x:Name="BtnTwRecommended" DockPanel.Dock="Left" Style="{StaticResource BtnLink}" Content="Empfohlene auswählen" Margin="14,0,0,0" VerticalAlignment="Center"/>
          <Button x:Name="BtnTwNone"        DockPanel.Dock="Left" Style="{StaticResource BtnLink}" Content="Auswahl aufheben" Margin="10,0,0,0" VerticalAlignment="Center"/>
          <Button x:Name="BtnTwRefresh" DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}" Content="Neu prüfen" Margin="8,0,0,0"/>
          <Button x:Name="BtnTwUndo"    DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}" Content="Rückgängig" Margin="8,0,0,0"
                  ToolTip="Stellt für die ausgewählten Tweaks den vorher gesicherten Zustand wieder her (nicht für einmalige Aktionen)."/>
          <Button x:Name="BtnTwApply"   DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Content="Anwenden"
                  ToolTip="Wendet die ausgewählten Tweaks an bzw. führt die ausgewählten Aktionen aus. Vorher wird gesichert (auf Windows 10/11 zusätzlich Wiederherstellungspunkt)."/>
        </DockPanel>

        <Border Grid.Row="4" Margin="0,14,0,0" Background="White" BorderBrush="#E3E3DF" BorderThickness="1" CornerRadius="4" Padding="1">
          <Grid>
            <DataGrid x:Name="GridTweaks">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="44" CanUserResize="False" SortMemberPath="Selected">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <CheckBox Tag="twsel" HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsChecked="{Binding Selected, Mode=OneWay}" IsEnabled="{Binding CanSelect}"
                                ToolTip="{Binding Tip}" ToolTipService.ShowOnDisabled="True"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Tweak" Width="2.6*" SortMemberPath="Title">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel>
                        <StackPanel.ToolTip>
                          <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" MaxWidth="460"/>
                        </StackPanel.ToolTip>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Detail}" Foreground="#80858A" FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Bereich" Width="95" SortMemberPath="Group">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Border Background="#EEF0EF" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding Group}" FontSize="11.5" Foreground="#3F4447"/>
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Art" Width="85" Binding="{Binding Category}" ElementStyle="{StaticResource CellText}"/>

                <DataGridTemplateColumn Header="Empfehlung" Width="105" SortMemberPath="Level">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource RdsBadge}">
                        <TextBlock Text="{Binding Level}" FontSize="11.5"/>
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Status" Width="130" SortMemberPath="StatusText">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel>
                        <TextBlock Text="{Binding StatusText}">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Foreground" Value="#5F6468"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusText}" Value="Umgesetzt">
                                  <Setter Property="Foreground" Value="#1F6F78"/>
                                  <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusText}" Value="Teilweise">
                                  <Setter Property="Foreground" Value="#7A5B12"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusText}" Value="Fehler">
                                  <Setter Property="Foreground" Value="#A02A22"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusText}" Value="Einmalig">
                                  <Setter Property="Foreground" Value="#7A5B12"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusText}" Value="Nicht zutreffend">
                                  <Setter Property="Foreground" Value="#9A9EA1"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusText}" Value="Nicht vorhanden">
                                  <Setter Property="Foreground" Value="#9A9EA1"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding UndoText}" Foreground="#80858A" FontSize="11" Margin="0,1,0,0">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding UndoText}" Value="">
                                  <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="TxtTwEmpty" Text="Keine passenden Tweaks." Foreground="#9A9EA1"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            <TextBlock x:Name="TxtTwLoading" Text="Betriebssystem und Tweaks werden geprüft …" Foreground="#8A8E91"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
          </Grid>
        </Border>
      </Grid>

      <!-- Seite: RDS-Optimierung -->
      <Grid x:Name="PageOptimize" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
          <TextBlock Style="{StaticResource PageTitle}" Text="RDS-Optimierung"/>
          <TextBlock Style="{StaticResource PageSub}"
                     Text="Vorschläge für Citrix-RDS-Hosts (angelehnt an Citrix Optimizer, Microsoft WDOT und die Citrix-Doku zu PVS, MCS und WEM). Jeder Punkt ist einzeln auswählbar; vor der ersten Änderung wird der ursprüngliche Zustand gesichert, „Rückgängig“ stellt ihn wieder her. Begründung im Tooltip – vor dem Einsatz im eigenen Umfeld testen, am besten im Master-Image."/>
        </StackPanel>

        <WrapPanel x:Name="OptDetect" Grid.Row="1" Margin="0,16,0,0"/>

        <StackPanel Grid.Row="2">
          <Border x:Name="OptPvsHint" Margin="0,4,0,0" Background="#FBEAEA" BorderBrush="#EBC4C1"
                  BorderThickness="1" CornerRadius="3" Padding="12,8" Visibility="Collapsed">
            <TextBlock TextWrapping="Wrap" Foreground="#7A231C"
                       Text="Dieses System läuft von einem nicht-persistenten Image (PVS-Standard-Modus bzw. MCS). Änderungen gehen beim nächsten Neustart verloren – Optimierungen in einer Wartungsversion bzw. im Master-Image vornehmen."/>
          </Border>
          <DockPanel Margin="0,4,0,0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="Cache-Laufwerk (PVS/MCSIO):" VerticalAlignment="Center" Foreground="#5F6468"/>
            <ComboBox x:Name="CmbOptCacheDrive" DockPanel.Dock="Left" Width="230" Margin="10,0,0,0" Padding="8,4" VerticalContentAlignment="Center"
                      ToolTip="Ziel für Ereignisprotokolle, Druckspooler, Auslagerungsdatei und WEM-Agent-Cache"/>
            <Button x:Name="BtnSeal" DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Content="Versiegeln und herunterfahren …" IsEnabled="False"
                    ToolTipService.ShowOnDisabled="True"
                    ToolTip="Nach jeder Image-Aktualisierung: führt alle einmaligen Aufräumschritte aus (WSUS-Kennung, Caches, Ereignisprotokolle, RDS-Kulanzfrist …) und fährt den Rechner herunter. Vorher erscheint die Liste der Schritte. Nur mit Administratorrechten."/>
            <TextBlock x:Name="TxtSealLast" DockPanel.Dock="Right" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="#80858A" FontSize="12"/>
          </DockPanel>
          <Border x:Name="OptAdminHint" Margin="0,4,0,0" Background="#FBF5E8" BorderBrush="#EADBB8"
                  BorderThickness="1" CornerRadius="3" Padding="12,8" Visibility="Collapsed">
            <TextBlock TextWrapping="Wrap" Foreground="#5E4B1F"
                       Text="Optimierungen lassen sich nur mit Administratorrechten anwenden. Der Zustand wird angezeigt, die Auswahl ist gesperrt."/>
          </Border>
        </StackPanel>

        <DockPanel Grid.Row="3" Margin="0,10,0,0" LastChildFill="False">
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
            <RadioButton x:Name="OptFltApplicable" GroupName="OptFlt" Style="{StaticResource Seg}" Content="Zutreffend" IsChecked="True"/>
            <RadioButton x:Name="OptFltOpen"       GroupName="OptFlt" Style="{StaticResource Seg}" Content="Offen"/>
            <RadioButton x:Name="OptFltDone"       GroupName="OptFlt" Style="{StaticResource Seg}" Content="Umgesetzt"/>
            <RadioButton x:Name="OptFltAll"        GroupName="OptFlt" Style="{StaticResource Seg}" Content="Alle"/>
          </StackPanel>
          <Button x:Name="BtnOptRecommended" DockPanel.Dock="Left" Style="{StaticResource BtnLink}" Content="Empfohlene auswählen" Margin="14,0,0,0" VerticalAlignment="Center"/>
          <Button x:Name="BtnOptNone"        DockPanel.Dock="Left" Style="{StaticResource BtnLink}" Content="Auswahl aufheben" Margin="10,0,0,0" VerticalAlignment="Center"/>
          <Button x:Name="BtnOptRefresh" DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}" Content="Neu prüfen" Margin="8,0,0,0"/>
          <Button x:Name="BtnOptUndo"    DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}" Content="Rückgängig" Margin="8,0,0,0"
                  ToolTip="Stellt für die ausgewählten Punkte den vor der Optimierung gesicherten Zustand wieder her."/>
          <Button x:Name="BtnOptApply"   DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Content="Anwenden"
                  ToolTip="Wendet die ausgewählten Optimierungen an. Vorher wird automatisch gesichert."/>
        </DockPanel>

        <Border Grid.Row="4" Margin="0,14,0,0" Background="White" BorderBrush="#E3E3DF" BorderThickness="1" CornerRadius="4" Padding="1">
          <Grid>
            <DataGrid x:Name="GridOptimize">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="44" CanUserResize="False" SortMemberPath="Selected">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <CheckBox Tag="optsel" HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsChecked="{Binding Selected, Mode=OneWay}" IsEnabled="{Binding CanSelect}"
                                ToolTip="{Binding Tip}" ToolTipService.ShowOnDisabled="True"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Optimierung" Width="2.6*" SortMemberPath="Title">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel>
                        <StackPanel.ToolTip>
                          <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" MaxWidth="460"/>
                        </StackPanel.ToolTip>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Detail}" Foreground="#80858A" FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Bereich" Width="95" SortMemberPath="Group">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Border Background="#EEF0EF" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding Group}" FontSize="11.5" Foreground="#3F4447"/>
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Art" Width="85" Binding="{Binding Category}" ElementStyle="{StaticResource CellText}"/>

                <DataGridTemplateColumn Header="Empfehlung" Width="105" SortMemberPath="Level">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource RdsBadge}">
                        <TextBlock Text="{Binding Level}" FontSize="11.5"/>
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Status" Width="130" SortMemberPath="StatusText">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel>
                        <TextBlock Text="{Binding StatusText}">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Foreground" Value="#5F6468"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusText}" Value="Umgesetzt">
                                  <Setter Property="Foreground" Value="#1F6F78"/>
                                  <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusText}" Value="Teilweise">
                                  <Setter Property="Foreground" Value="#7A5B12"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusText}" Value="Fehler">
                                  <Setter Property="Foreground" Value="#A02A22"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusText}" Value="Nicht zutreffend">
                                  <Setter Property="Foreground" Value="#9A9EA1"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusText}" Value="Nicht vorhanden">
                                  <Setter Property="Foreground" Value="#9A9EA1"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding UndoText}" Foreground="#80858A" FontSize="11" Margin="0,1,0,0">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding UndoText}" Value="">
                                  <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="TxtOptEmpty" Text="Keine passenden Optimierungen." Foreground="#9A9EA1"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
