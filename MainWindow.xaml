          <Button x:Name="BtnSwUpdateSel"  DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Content="Ausgewählte aktualisieren" IsEnabled="False"/>
        </DockPanel>

        <Border Grid.Row="4" Margin="0,14,0,0" Background="White" BorderBrush="#E3E3DF" BorderThickness="1" CornerRadius="4" Padding="1">
          <Grid>
            <DataGrid x:Name="GridSoftware">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="44" CanUserResize="False" SortMemberPath="Selected">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <CheckBox Tag="swsel" HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsChecked="{Binding Selected, Mode=OneWay}" IsEnabled="{Binding CanSelect}"
